# Скопируйте в .env и заполните

# Строка подключения к PostgreSQL (Railway/Render/Supabase дают её готовой)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Секрет для подписи JWT-токенов — любая длинная случайная строка
JWT_SECRET=change_me_to_a_long_random_string

# API-ключ FACEIT (Server-side API key), получить тут:
# https://developers.faceit.com/ -> Create app -> Server-side API key
FACEIT_API_KEY=your_faceit_server_api_key

# Ключ Anthropic API для серверного ИИ-совета тренера (/api/advice)
# Получить: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key

# Как часто фоновый воркер проверяет новые матчи у всех пользователей (мс)
SYNC_INTERVAL_MS=300000

# Порт сервера
PORT=3000
